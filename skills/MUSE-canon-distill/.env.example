# MUSE-canon-distill — API 配置模板
#
# 用法（任一种）：
#   1. 复制为 .env 放在 plugin 根目录（python-dotenv 自动加载）：
#        cp .env.example .env
#        编辑 .env 填入真实 key
#   2. 或在 shell 直接 export（推荐写进 ~/.bashrc / ~/.zshrc 持久化）：
#        export MUSE_KB_API_KEY="sk-..."
#        export MUSE_KB_BASE_URL="https://your-compatible-endpoint.example/v1"
#
# 验证：python3 knowledge-base/scripts/kb_setup_check.py
#
# 注意：.env 已加入 .gitignore，不会被 commit；不要把 .env 推上 GitHub。
# 不要直接编辑 .env.example 后填入 key（这个文件会被 commit）——它是模板。

# === 必填 ===

# Embedding API key（kb_query.py 调远程 embedding 时用）
MUSE_KB_API_KEY=

# === 可选 ===

# Embedding API base URL，默认通用占位地址；替换为你的兼容服务地址
# 兼容旧名 API_BASE_URL
MUSE_KB_BASE_URL=https://your-compatible-endpoint.example/v1
